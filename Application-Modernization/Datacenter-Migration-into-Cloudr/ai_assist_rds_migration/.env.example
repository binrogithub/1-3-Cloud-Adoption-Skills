# ---- Huawei Cloud Authentication (Source Account A) ----
HW_ACCESS_KEY=FILL_ME
HW_SECRET_KEY=FILL_ME
HW_PROJECT_ID=3b1dbd8270424257930b2e95bc150916
HW_REGION=la-north-2

# ---- Source Database (Huawei Cloud RDS for MySQL 8.0) ----
# Instance: rds-migration-test (136ed89ff0514211a1cd5cb2cfc76856in01)
# Private IP: 10.0.102.2
SRC_DB_HOST=10.0.102.2
SRC_DB_PORT=3306
SRC_DB_USER=root
SRC_DB_PASSWORD=FILL_ME

# ---- Target Database (Account B RDS for MySQL 8.0) ----
# Instance: rds-mysql8-prod-migration-target (4b028534dd6641b28b6e8a3e773e3fecin01)
# Private IP: 10.101.0.21
TGT_DB_HOST=10.101.0.21
TGT_DB_PORT=3306
TGT_DB_USER=root
TGT_DB_PASSWORD=FILL_ME

# ---- Dry-Run Mode ----
# true = simulate only, no actual API calls or changes (DEFAULT)
# false = execute real operations (requires approvals)
DRY_RUN=true
