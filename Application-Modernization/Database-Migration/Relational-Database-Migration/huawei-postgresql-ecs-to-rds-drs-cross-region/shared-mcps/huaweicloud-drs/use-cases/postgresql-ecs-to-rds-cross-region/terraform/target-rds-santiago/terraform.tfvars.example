# terraform.tfvars.example
# Copy to terraform.tfvars and fill in values.
# NEVER commit terraform.tfvars with real secrets.

region = "la-south-2"

availability_zone = "la-south-2a"

# Set RDS pass via env: export TF_VAR_rds_password="..."
# Do NOT uncomment the line below with a real value:
# rds_password = "CHANGE_ME_DO_NOT_COMMIT_REAL_PASSWORD"

# DRS CIDR - replace with actual DRS source CIDR from console
allowed_drs_cidr = "REPLACE_WITH_DRS_SOURCE_CIDR"

# DAS CIDR - replace with DAS access CIDR
allowed_das_cidr = "REPLACE_WITH_DAS_CIDR"

admin_ssh_cidr = "YOUR_IP/32"
