# Required: Huawei Cloud account credentials
HC_AK=""
HC_SK=""

# Required: Source VM and regions
SOURCE_SERVER_ID=""
SOURCE_REGION=""
TARGET_REGION=""

# Optional: display name for target region in SMS migproject; when empty script auto-resolves
TARGET_REGION_NAME=""

# Required: target image + initial password
TARGET_IMAGE_ID=""
TARGET_ADMIN_PASSWORD=""

# Optional target ECS/network parameters
TARGET_SERVER_NAME="vm-migrated"
TARGET_FLAVOR_ID=""
TARGET_VPC_NAME="vpc-migration"
TARGET_VPC_CIDR="10.250.0.0/16"
TARGET_SUBNET_CIDR="10.250.1.0/24"
EIP_BANDWIDTH_MBPS="5"
ROOT_VOLUME_TYPE="SSD"
DATA_VOLUME_TYPE="SSD"
SMS_ENDPOINT="https://sms.ap-southeast-3.myhuaweicloud.com"

# Optional migration strategy: sms | rsync
PREFERRED_MIGRATION_METHOD="sms"
ENABLE_RSYNC_FALLBACK="true"

# Optional source network hints
SOURCE_PRIVATE_IP=""
EXTRA_PEER_IPS=""

# Optional rsync settings (required when using rsync mode)
RSYNC_SOURCE_HOST=""
RSYNC_SOURCE_PORT="22"
RSYNC_SOURCE_USER="root"
RSYNC_SOURCE_PASSWORD=""
RSYNC_TARGET_HOST=""
RSYNC_TARGET_PORT="22"
RSYNC_TARGET_USER="root"
RSYNC_TARGET_PASSWORD=""
RSYNC_SOURCE_PATHS="/"
RSYNC_STAGING_DIR="/tmp/mgc-rsync-stage"
RSYNC_INCREMENTAL_ROUNDS="1"
RSYNC_TIMEOUT_SEC="7200"
RSYNC_COMMON_ARGS="--numeric-ids --info=stats2,progress2 --partial"
RSYNC_EXCLUDES="/dev/*,/proc/*,/sys/*,/tmp/*,/run/*,/mnt/*,/media/*,/lost+found,/swapfile,/var/tmp/*,/var/run/*,/boot/efi/*,/etc/fstab"
RSYNC_CUTOVER_STOP_CMD=""
RSYNC_CUTOVER_START_CMD=""
RSYNC_TARGET_FINALIZE_CMD=""

# Optional VPN bridge settings
ENABLE_VPN_BRIDGE="true"
ENABLE_TARGET_VPN_CLIENT="true"
VPN_SERVER_PUBLIC_IP=""
VPN_SERVER_PORT="1194"
VPN_CLIENT_COMMON_NAME="vm-migration-target"
VPN_CLIENT_STATIC_IP="10.8.0.10"

# Output path
RESULT_PATH="./out/migration_result.json"
