# Copy to config/local/prometheus.env and source it in the adapter process.
PROMETHEUS_BASE_URL="https://prometheus.example.internal"
PROMETHEUS_BEARER_TOKEN=""
PROMETHEUS_TIMEOUT_SECONDS="10"
PROMETHEUS_VERIFY_TLS="1"
# The policy file maps the target service to the Prometheus label `job` on the
# current development host. Change the policy mapping for another environment.
