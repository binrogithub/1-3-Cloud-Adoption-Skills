# Optional runtime override for the directory created by css-register.py.
# The directory must contain clusters/<profile>.json and credentials/<id>.json.
export AUTOOPS_CSS_CONFIG_DIR="/etc/jiuwenswarm-autoops/css"
# Required only when enabling the CSS watcher systemd timer.
# export AUTOOPS_CSS_PROFILE_ID="production-search"

# For non-interactive registration only. Do not commit real values.
# export HUAWEICLOUD_SDK_AK="replace-with-ak"
# export HUAWEICLOUD_SDK_SK="replace-with-sk"

# Optional KooCLI adapter. The profile stores authentication in KooCLI;
# JiuwenSwarm passes only region, project_id and cluster_id to hcloud.
# export AUTOOPS_KOO_CLI="/usr/local/bin/hcloud"
# export AUTOOPS_KOO_CLI_PROFILE="default"
