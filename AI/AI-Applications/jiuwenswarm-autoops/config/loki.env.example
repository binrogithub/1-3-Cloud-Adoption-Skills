# Copy to config/local/loki.env on the deployment host; keep it mode 0600.
# Never commit real tenant IDs or bearer tokens.
LOKI_BASE_URL="https://loki.example.internal"
LOKI_TENANT_ID=""
LOKI_BEARER_TOKEN=""
LOKI_SERVICE_LABEL="service"
LOKI_TIMEOUT_SECONDS="15"
AUTOOPS_OBSERVABILITY_MAX_WINDOW_MINUTES="1440"
# If Loki returns no data (or is unavailable), query the local systemd journal
# for the requested unit. Set to 0 only when this host must never be inspected.
AUTOOPS_LOCAL_JOURNAL_FALLBACK="1"
