{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JiuwenSwarm AutoOps Release Evidence Envelope",
  "type": "object",
  "required": [
    "schema_version", "epic_id", "task_id", "run_id", "attempt", "commit",
    "artifact_sha256", "config_sha256", "case_manifest_sha256",
    "environment_manifest_ref", "started_at", "finished_at", "status",
    "evidence_refs", "reason"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "epic_id": {"type": "string", "pattern": "^REL-[0-9]{2}$"},
    "task_id": {"type": "string", "pattern": "^REL-[0-9]{2}-[0-9]{2}$"},
    "case_id": {"type": "string", "pattern": "^(AO50-[0-9]{2}|REL-[0-9]{2}-[0-9]{2})$"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "attempt": {"type": "integer", "minimum": 1},
    "commit": {"type": "string", "minLength": 7},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_manifest_ref": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "N/A"]},
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
