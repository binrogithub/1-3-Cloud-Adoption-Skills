# Copy to /etc/jiuwenswarm-autoops/noli.env (or a configured AutoOps config directory).
# Use a dedicated NOLI account. Current NOLI auth has no viewer role: restrict this
# integration to the two GET endpoints at the network/API gateway; never commit the token.
NOLI_BASE_URL=https://noli.example.internal
NOLI_BEARER_TOKEN=
NOLI_TIMEOUT_SECONDS=10
