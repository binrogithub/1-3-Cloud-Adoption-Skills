[Unit]
Description=JiuwenSwarm AutoOps restore Santiago CSS to two data nodes after pressure guardrail
Requires=jiuwenswarm-css-chile-tunnel.service
After=network-online.target jiuwenswarm-css-chile-tunnel.service

[Service]
Type=oneshot
User=jiuwenswarm-autoops
Group=jiuwenswarm-autoops
Environment=HOME=/var/lib/jiuwenswarm-autoops
Environment=AUTOOPS_CSS_ACTION_DB=/var/lib/jiuwenswarm-autoops/css-actions.sqlite3
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3.9 /opt/Jiuwenswarm_AutoOps/scripts/css-live-pressure.py --profile-id css-santiago-24h-test --config-dir /etc/jiuwenswarm-autoops/css --state-dir /var/lib/jiuwenswarm-autoops/css-recovery-after-guardrail --evidence /var/lib/jiuwenswarm-autoops/css-recovery-after-guardrail/evidence.json --iterations 6 --interval-seconds 0 --max-actions 6 --execute --business-config /etc/jiuwenswarm-autoops/css/business-chile-24h-test.json --target-nodes 2 --max-scale-in-step 1
TimeoutStartSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jiuwenswarm-autoops

[Install]
WantedBy=multi-user.target
