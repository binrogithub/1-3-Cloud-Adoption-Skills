[Unit]
Description=JiuwenSwarm AutoOps Alertmanager webhook bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jiuwenswarm-autoops
Group=jiuwenswarm-autoops
WorkingDirectory=/opt/Jiuwenswarm_AutoOps
ExecStart=/usr/bin/python3 /opt/Jiuwenswarm_AutoOps/scripts/autoops_alertmanager_webhook.py --listen 127.0.0.1:19002 --events-file /var/lib/jiuwenswarm-autoops/events.jsonl
EnvironmentFile=-/etc/jiuwenswarm-autoops/alertmanager.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jiuwenswarm-autoops

[Install]
WantedBy=multi-user.target
