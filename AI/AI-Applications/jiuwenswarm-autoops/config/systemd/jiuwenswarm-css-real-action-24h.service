[Unit]
Description=JiuwenSwarm AutoOps Chile CSS 24-hour pressure and scaling validation
Requires=jiuwenswarm-css-chile-tunnel.service
After=network-online.target jiuwenswarm-css-chile-tunnel.service
Wants=network-online.target

[Service]
Type=simple
User=jiuwenswarm-autoops
Group=jiuwenswarm-autoops
Environment=HOME=/var/lib/jiuwenswarm-autoops
Environment=AUTOOPS_CSS_ACTION_DB=/var/lib/jiuwenswarm-autoops/css-actions.sqlite3
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/systemctl is-active jiuwenswarm-css-chile-tunnel.service
ExecStart=/usr/bin/python3.9 /opt/Jiuwenswarm_AutoOps/scripts/css-24h-launch.py --profile-id css-santiago-24h-test --config-dir /etc/jiuwenswarm-autoops/css --plan /etc/jiuwenswarm-autoops/css/pressure-24h-chile-test.json --duration-seconds 86400 --state-dir /var/lib/jiuwenswarm-autoops/css-24h-pressure --evidence /var/lib/jiuwenswarm-autoops/css-24h-pressure/evidence.json --execute --confirm-business-impact --css-actions execute --confirm-css-writes
Restart=on-abnormal
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jiuwenswarm-autoops

[Install]
WantedBy=multi-user.target
