[Unit]
Description=JiuwenSwarm AutoOps bounded event watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jiuwenswarm-autoops
Group=jiuwenswarm-autoops
WorkingDirectory=/opt/Jiuwenswarm_AutoOps
ExecStart=/usr/bin/python3 /opt/Jiuwenswarm_AutoOps/scripts/autoops_watch.py --policy /etc/jiuwenswarm-autoops/monitoring/autoops-demo-watch.json --events-file /var/lib/jiuwenswarm-autoops/events.jsonl --state-dir /var/lib/jiuwenswarm-autoops/watch
Environment=AUTOOPS_STATE_DB=/var/lib/jiuwenswarm-autoops/autoops-state.db
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jiuwenswarm-autoops

[Install]
WantedBy=multi-user.target
