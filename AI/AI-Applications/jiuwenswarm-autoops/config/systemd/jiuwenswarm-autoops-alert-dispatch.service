[Unit]
Description=JiuwenSwarm AutoOps Alertmanager incident dispatcher
After=jiuwenswarm-autoops-watch.service

[Service]
Type=oneshot
User=jiuwenswarm-autoops
Group=jiuwenswarm-autoops
WorkingDirectory=/opt/Jiuwenswarm_AutoOps
ExecStart=/usr/bin/python3 /opt/Jiuwenswarm_AutoOps/scripts/autoops_alert_dispatch.py --policy /etc/jiuwenswarm-autoops/monitoring/autoops-demo-watch.json --events-file /var/lib/jiuwenswarm-autoops/events.jsonl --state-dir /var/lib/jiuwenswarm-autoops/watch --outbox-file /var/lib/jiuwenswarm-autoops/notifications.jsonl
Environment=AUTOOPS_STATE_DB=/var/lib/jiuwenswarm-autoops/autoops-state.db
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jiuwenswarm-autoops

[Install]
WantedBy=multi-user.target
