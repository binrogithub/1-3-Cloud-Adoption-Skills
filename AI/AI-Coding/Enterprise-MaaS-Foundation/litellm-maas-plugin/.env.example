# Client-side configuration for client/configure-claude-code.sh (all optional;
# the API key is normally passed as a CLI argument).
LITELLM_BASE_URL=http://127.0.0.1:4000
CLAUDE_CODE_MODEL=claude-opus-4-6

# Server-side plugin toggle (set in the LiteLLM container environment):
# ASG_STRIP_THINKING=true   # strip Anthropic thinking/reasoning params (default)
# ASG_TOOL_MODEL=claude-opus-4.8  # optional reliable lane for tool requests
