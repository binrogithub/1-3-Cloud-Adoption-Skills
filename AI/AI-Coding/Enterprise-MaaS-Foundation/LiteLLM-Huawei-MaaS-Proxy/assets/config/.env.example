# ── Proxy Auth ───────────────────────────────────
LITELLM_MASTER_KEY="sk-change-me"
LITELLM_SALT_KEY="change-me-to-a-long-random-string"

# ── Database ─────────────────────────────────────
DB_PASSWORD="change-me-to-a-strong-password"

# ── Huawei MaaS ──────────────────────────────────
# Mandatory main API key (from ModelArts MaaS console, ap-southeast-1):
HUAWEI_MAAS_API_KEY="change-me-to-your-maas-api-key"
# Optional additional API keys for load balancing (comma-separated):
# HUAWEI_MAAS_EXTRA_API_KEYS="key2,key3"
# ── The following are written by init_env.sh — do not edit manually ──
# If you set up .env manually (without init_env.sh), you MUST also set:
HUAWEI_MAAS_API_KEY_0="change-me-to-your-maas-api-key"
# HUAWEI_MAAS_API_KEY_COUNT=1
# HUAWEI_MAAS_API_KEY_1="..."
HUAWEI_MAAS_API_BASE="https://api-ap-southeast-1.modelarts-maas.com/openai/v1"

# ── Prometheus ───────────────────────────────────
PROMETHEUS_RETENTION="15d"

# ── Grafana ──────────────────────────────────────
GRAFANA_PASSWORD="change-me-to-a-strong-password"

# ── Optional Claude Code / claude-glm features ───
# Exa enables LiteLLM-side current web search injection for search-intent prompts.
# Leave empty to disable live search while keeping normal model calls available.
EXA_API_KEY=""

# OpenRouter enables automatic image request routing to the vision-openrouter
# model group. Leave empty if image inputs are not needed.
OpenRouter_API_KEY=""

# Optional LiteLLM virtual key used by a local CCR client such as claude-glm.
LITELLM_CCR_KEY=""

# ── Optional self-hosted SearXNG search MCP (profile: search) ──
# Enables the searxng + searxng-mcp containers as a self-hosted alternative to
# Exa. Start them with: docker compose --profile search up -d
# MCP_TOKEN is the bearer token clients present to the MCP on :8788. Generate
# with: openssl rand -hex 16 . Required only when the search profile is used.
MCP_TOKEN=""
# Secret key for the SearXNG instance. Generate with: openssl rand -hex 32 .
# Used when rendering assets/config/searxng/settings.yml from settings.yml.example.
SEARXNG_SECRET=""
