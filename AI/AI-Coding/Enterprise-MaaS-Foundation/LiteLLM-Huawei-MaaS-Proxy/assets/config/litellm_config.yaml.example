# ─────────────────────────────────────────────────────────────────────────────
# LiteLLM Config Example (Single-Key Reference)
#
# This is a REFERENCE example showing single-key configuration.
# The actual config is GENERATED by scripts/generate_config.sh which creates
# N deployments per model (one for each HUAWEI_MAAS_API_KEY_N).
#
# Do NOT edit this file directly. Instead:
#   1. Run scripts/init_env.sh to set up .env with your MaaS API keys
#   2. Run scripts/generate_config.sh to generate the actual config
#
# Generated config will use: os.environ/HUAWEI_MAAS_API_KEY_0, _1, _2, etc.
#
# The generator also emits, to match the production deployment:
#   • rolling_budget_hook.proxy_handler_instance — three-tier rolling-window
#     budget (BUDGET_TIER_* env; effectively unlimited until those are set).
#   • search_tools (exa-search) + the websearch_interception callback —
#     ONLY when EXA_API_KEY is set (shown commented below).
#   • proxy_batch_write_at: 1 — near-real-time spend so the budget hook is timely.
#
# The optional BR fintech DLP guardrails are NOT generated (they require the
# external risk-control module to be mounted first) — see the commented
# "guardrails:" reference block near the end and references/operations.md.
# ─────────────────────────────────────────────────────────────────────────────

model_list:

  # ───────── OpenRouter Vision Models (image requests auto-routed here) ─────────

  - model_name: vision-openrouter
    litellm_params:
      model: openrouter/openai/gpt-4o
      api_key: os.environ/OpenRouter_API_KEY
      api_base: https://openrouter.ai/api/v1
      tpm: 800000
      rpm: 100
    model_info:
      supports_vision: true
      max_tokens: 16384
      max_input_tokens: 128000
      max_output_tokens: 16384
      input_cost_per_token: 0.0000025
      output_cost_per_token: 0.00001

  - model_name: vision-openrouter
    litellm_params:
      model: openrouter/anthropic/claude-opus-4
      api_key: os.environ/OpenRouter_API_KEY
      api_base: https://openrouter.ai/api/v1
      tpm: 400000
      rpm: 50
    model_info:
      supports_vision: true
      max_tokens: 32000
      max_input_tokens: 200000
      max_output_tokens: 32000
      input_cost_per_token: 0.000015
      output_cost_per_token: 0.000075

  # ───────── Huawei MaaS Models (1 deployment(s) per model, 7 total) ───────────

  - model_name: glm-5.1
    litellm_params:
      model: openai/glm-5.1
      api_base: os.environ/HUAWEI_MAAS_API_BASE
      api_key: os.environ/HUAWEI_MAAS_API_KEY_0
      tpm: 500000
      rpm: 30
    model_info:
      max_tokens: 198000
      max_input_tokens: 192000
      max_output_tokens: 128000
      input_cost_per_token: 0.000001078
      output_cost_per_token: 0.000003774

  - model_name: claude-opus-4-6
