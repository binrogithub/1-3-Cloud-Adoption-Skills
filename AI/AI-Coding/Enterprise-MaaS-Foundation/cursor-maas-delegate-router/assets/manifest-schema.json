{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor-maas-manifest",
  "title": "WorkflowManifest",
  "type": "object",
  "required": ["items"],
  "properties": {
    "workflow_id": { "type": "string" },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 16, "default": 3 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["goal", "files", "acceptance"],
        "properties": {
          "id": { "type": "string" },
          "goal": { "type": "string" },
          "files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptance": { "type": "string" },
          "constraints": {
            "type": "array",
            "items": { "type": "string" }
          },
          "context": { "type": "string" },
          "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
