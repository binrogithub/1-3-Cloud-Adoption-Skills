# terraform.tfvars.example
# Copy to terraform.tfvars and fill in values.
# NEVER commit terraform.tfvars with real secrets.

region = "cn-north-4"

availability_zone = "cn-north-4a"

# Set ECS admin pass via env: export TF_VAR_ecs_admin_password="..."
# Do NOT uncomment the line below with a real value:
# ecs_admin_password = "REPLACE_WITH_STRONG_PASSWORD"

admin_ssh_cidr = "YOUR_IP/32"

# DRS source CIDR - replace with the actual CIDR shown in DRS console
# EXPERIMENTAL: This is a public CIDR for Internet-based DRS
# FUTURE VPN: Replace with VPN/private CIDR
allowed_drs_cidr = "REPLACE_WITH_DRS_SOURCE_CIDR"

eip_bandwidth_mbps = 5
