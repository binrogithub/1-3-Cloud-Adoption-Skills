{
  "name": "dataarts-deploy-agent",
  "version": "0.2.0",
  "description": "Dry-run deployment agent for Huawei Cloud DataArts Factory (Snowflake migration demo)",
  "private": true,
  "scripts": {
    "validate-env": "node src/validate-env.js",
    "dry-run": "node src/dry-run.js",
    "load-artifacts": "node -e \"require('./src/load-artifacts.js').loadAll().then(a => console.log(JSON.stringify(Object.keys(a), null, 2)))\"",
    "audit-payload": "node src/audit-payload.js",
    "live-validate": "node src/live-validate.js",
    "deploy:plan": "node src/deploy-plan.js",
    "create-job": "node src/create-job.js",
    "inspect-request": "node src/inspect-request.js",
    "verify-job": "node src/verify-job.js",
    "export-evidence": "node src/export-evidence.js",
    "publish:plan": "node src/publish-plan.js",
    "export-job-definition": "node src/export-job-definition.js",
    "runtime:plan": "node src/runtime-plan.js",
    "prepare-dli-demo-data:plan": "node src/prepare-dli-demo-data-plan.js",
    "dli:validate": "node src/dli-validate.js",
    "prepare-dli-demo-data": "node src/prepare-dli-demo-data.js",
    "dli:validate-demo-data": "node src/dli-validate-demo-data.js",
    "reset-dli-demo-data": "node src/reset-dli-demo-data.js",
    "adapt-sql-for-demo-runtime": "node src/adapt-sql-for-demo-runtime.js",
    "run-immediate:plan": "node src/run-immediate-plan.js",
    "run-immediate-job": "node src/run-immediate-job.js",
    "runtime-validate": "node src/runtime-validate.js",
    "diagnose-run-failure": "node src/diagnose-run-failure.js",
    "adapt-sql-single-statement-v4": "node src/adapt-sql-single-statement-v4.js",
    "demo:one-shot:plan": "node src/demo-one-shot-plan.js",
    "demo:one-shot": "node src/demo-one-shot.js",
    "demo:one-shot:doctor": "node src/demo-one-shot-doctor.js",
    "demo:one-shot:status": "node src/demo-one-shot-status.js",
    "demo:equivalence-summary": "node src/demo-equivalence-summary.js",
    "mcp": "node src/mcp-server.mjs",
    "test": "node --test test/**/*.test.js",
    "manifest:validate:golden": "node -e \"const { loadArtifactManifest } = require('./src/artifacts/manifest-loader'); const r = loadArtifactManifest('./cases/golden/orders_pipeline_simple/target/artifact_manifest.json'); console.log(JSON.stringify(r, null, 2)); process.exit(r.valid ? 0 : 1);\"",
    "migration:package:validate:golden": "node -e \"const { loadMigrationPackage } = require('./src/migration/package-loader'); const r = loadMigrationPackage('./cases/golden/orders_pipeline_simple'); console.log(JSON.stringify({ valid: r.valid, migration_id: r.migration_id, errors: r.errors, warnings: r.warnings, nodes: r.artifact_manifest_result?.nodes?.length }, null, 2)); process.exit(r.valid ? 0 : 1);\"",
    "migration:plan": "node src/migration-plan.js",
    "migration:doctor": "node src/migration-doctor.js",
    "migration:prepare-runtime": "node src/migration-prepare-runtime.js",
    "migration:execute-plan": "node src/migration-execute-plan.js",
    "runtime:engine:dry-run": "node src/runtime-engine-dry-run.js",
    "migration:execute": "node src/migration-execute.js",
    "runtime:adapter:dry-run": "node src/runtime-adapter-dry-run.js",
    "koocli:doctor": "node src/koocli-doctor.js",
    "migration:batch-assess": "node src/migration-batch-assess.js",
    "migration:batch-validate": "node src/migration-batch-validate.js",
    "migration:mvp-report": "node src/migration-mvp-report.js",
    "runtime:native-plan": "node src/runtime-native-plan.js",
    "runtime:native-simulate": "node src/runtime-native-simulate.js",
    "runtime:native-execute:mock": "node src/runtime-native-execute-mock.js",
    "runtime:native-execute:guarded": "node src/runtime-native-execute-guarded.js",
    "dli:client:doctor": "node src/dli-client-doctor.js",
    "dli:client:plan": "node src/dli-client-plan.js",
    "dli:client:live-preflight": "node src/dli-client-live-preflight.js",
    "dli:transport:plan": "node src/dli-transport-plan.js",
    "dli:submit-job:audit": "node src/dli-submit-job-audit.js",
    "dli:queue:health": "node src/dli-queue-health.js",
    "release:mvp-v0.1:check": "npm test && npm run migration:execute -- --dry-run --adapter legacy-demo --package-dir cases/golden/orders_pipeline_simple --job-name mvp_v01_release_check --dli-queue default"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0"
  }
}
