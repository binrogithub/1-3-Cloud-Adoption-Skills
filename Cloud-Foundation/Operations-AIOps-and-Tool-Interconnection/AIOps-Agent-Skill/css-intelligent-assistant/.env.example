# AI provider
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini

# Thresholds - basic
CPU_SPIKE_THRESHOLD=80
DISK_SPIKE_THRESHOLD=85

# Thresholds - extended
JVM_HEAP_SPIKE_THRESHOLD=85
SEARCH_LATENCY_SPIKE_THRESHOLD=500
INDEXING_LATENCY_SPIKE_THRESHOLD=200
THREAD_POOL_QUEUE_SPIKE_THRESHOLD=100

# AI diagnosis
AI_DIAGNOSE_ENABLED=true
AI_AUTO_FIX_ENABLED=false

# Node limits
MIN_NODES=2
MAX_NODES=10

# Scale step (configurable)
SCALE_OUT_STEP=1
SCALE_IN_STEP=1

# Cooldown
SCALE_OUT_COOLDOWN_MINUTES=10
SCALE_IN_COOLDOWN_MINUTES=30

# Scale-in guard: minimum minutes after scale-out before scale-in
SCALE_IN_DELAY_AFTER_SCALE_OUT_MINUTES=30

# Check interval
CHECK_INTERVAL_SECONDS=60

# Cluster
CLUSTER_ID=replace-me
CLUSTER_NAME=css-cluster

# Mutation toggle (set to true to actually execute CSS scaling)
CSS_MUTATION_ENABLED=false

# Huawei Cloud
HUAWEICLOUD_SDK_AK=replace-me
HUAWEICLOUD_SDK_SK=replace-me
HUAWEICLOUD_REGION=cn-north-4
HUAWEICLOUD_PROJECT_ID=replace-me
HUAWEICLOUD_CSS_ENDPOINT=
HUAWEICLOUD_CES_ENDPOINT=

# Dashboard server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
